# ---------- API (apps/api) ----------
NODE_ENV=development
API_PORT=3333
# prefixo obrigatório /api/v1 é aplicado pela própria API
CORS_ORIGIN=http://localhost:3000
# Swagger somente em ambiente autorizado
SWAGGER_ENABLED=true

# MySQL 8
DATABASE_URL="mysql://root:root@localhost:3306/sena_crm"

# Sessão: gere um segredo próprio (ex.: openssl rand -hex 32)
JWT_SECRET="troque-este-segredo-por-32-ou-mais-caracteres"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Seed do administrador SENA (somente dev / uso controlado)
SEED_ADMIN_EMAIL=admin@senaimoveis.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha-agora
SEED_ADMIN_NAME="Administrador SENA"

# ---------- WEB (apps/web) ----------
VITE_API_URL=http://localhost:3333/api/v1
