// SENA CRM — schema.
// Etapa 0: fundação multi-tenant. Etapa 1: acesso, sessão, equipes e auditoria.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// A URL de conexão fica em prisma.config.ts (exigência do Prisma 7).
datasource db {
  provider = "mysql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  PLATFORM_ADMIN
  ADMIN
  MANAGER
  BROKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

/// Imobiliária. Todo dado operacional é vinculado a um Tenant.
model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  legalName String?
  document  String?      @unique // CNPJ
  timezone  String       @default("America/Sao_Paulo")
  locale    String       @default("pt-BR")
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  users          User[]
  teams          Team[]
  brokerProfiles BrokerProfile[]
  sessions       RefreshSession[]
  resetTokens    PasswordResetToken[]
  auditLogs      AuditLog[]

  clients         Client[]
  clientRoles     ClientRoleAssignment[]
  leadOrigins     LeadOrigin[]
  campaigns       Campaign[]
  leads           Lead[]
  leadStatusLogs  LeadStatusHistory[]
  activities      Activity[]


  properties         Property[]
  propertyOwners    PropertyOwner[]
  propertyFeatures  PropertyFeature[]
  assets            Asset[]
  interestProfiles  InterestProfile[]

  @@index([status])
  @@map("tenants")
}

/// Acesso ao sistema. Dados profissionais do corretor ficam em BrokerProfile.
model User {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  email        String
  passwordHash String     @db.VarChar(255)
  role         UserRole   @default(BROKER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  brokerProfile BrokerProfile?
  managedTeams  Team[]               @relation("TeamManager")
  ledProfiles   BrokerProfile[]      @relation("BrokerManager")
  sessions      RefreshSession[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]

  clientsResponsible Client[]            @relation("ClientResponsible")
  leadsAssigned      Lead[]              @relation("LeadBroker")
  leadStatusChanges  LeadStatusHistory[] @relation("LeadStatusAuthor")
  activitiesCreated  Activity[]          @relation("ActivityAuthor")


  propertiesCaptored Property[] @relation("PropertyCaptator")
  assetsCreated      Asset[]    @relation("AssetAuthor")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

model Team {
  id            String     @id @default(cuid())
  tenantId      String
  name          String
  managerUserId String?
  status        TeamStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  manager User?           @relation("TeamManager", fields: [managerUserId], references: [id])
  brokers BrokerProfile[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("teams")
}

model BrokerProfile {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String   @unique
  creci         String?
  phone         String?
  whatsapp      String?
  teamId        String?
  managerUserId String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  user    User   @relation(fields: [userId], references: [id])
  team    Team?  @relation(fields: [teamId], references: [id])
  manager User?  @relation("BrokerManager", fields: [managerUserId], references: [id])

  @@index([tenantId])
  @@index([teamId])
  @@map("broker_profiles")
}

/// Sessão de refresh rotativa e revogável. Só o hash do token é persistido.
model RefreshSession {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?   @db.VarChar(512)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

/// Token de recuperação de senha: uso único, expira e é persistido apenas como hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, usedAt])
  @@map("password_reset_tokens")
}

/// Auditoria de ações críticas (ARCHITECTURE.md §20). Nunca guarda segredos.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String   @db.VarChar(64)
  entity    String?  @db.VarChar(64)
  entityId  String?
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Etapa 2 — cliente unificado, origens, campanhas, leads e atividades
// ---------------------------------------------------------------------------

enum ClientType {
  PERSON
  COMPANY
}

enum DocumentType {
  CPF
  CNPJ
}

enum ClientRole {
  BUYER
  OWNER
  LESSOR
  TENANT
  INVESTOR
}

enum LeadStatus {
  NEW
  CONTACT
  QUALIFIED
  PROPERTY_PRESENTED
  VISIT
  PROPOSAL
  NEGOTIATION
  CLOSED
  LOST
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  VISIT
  NOTE
}

/// Pessoa ou empresa. Um mesmo Client acumula papéis (ARCHITECTURE.md §10):
/// não existem cadastros separados de comprador, proprietário, locador ou locatário.
model Client {
  id                  String       @id @default(cuid())
  tenantId            String
  type                ClientType   @default(PERSON)
  name                String
  documentType        DocumentType?
  /// Documento normalizado sob AES-256-GCM; o valor em claro nunca é persistido.
  documentEncrypted   String?      @db.VarChar(512)
  /// HMAC determinístico: permite busca e checagem de duplicidade sem decifrar.
  documentHash        String?      @db.VarChar(64)
  documentLast4       String?      @db.VarChar(4)
  phone               String?      @db.VarChar(32)
  whatsapp            String?      @db.VarChar(32)
  email               String?      @db.VarChar(180)
  responsibleBrokerId String?
  lastContactAt       DateTime?
  nextContactAt       DateTime?
  notes               String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  responsibleBroker User?                 @relation("ClientResponsible", fields: [responsibleBrokerId], references: [id])
  roles             ClientRoleAssignment[]
  leads             Lead[]
  activities        Activity[]

  @@unique([tenantId, documentHash])
  @@index([tenantId, name])
  propertyOwnerships PropertyOwner[]
  interestProfile    InterestProfile?
  @@index([tenantId, responsibleBrokerId])
  @@map("clients")
}

model ClientRoleAssignment {
  id        String     @id @default(cuid())
  tenantId  String
  clientId  String
  role      ClientRole
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, role])
  @@index([tenantId, role])
  @@map("client_role_assignments")
}

/// Origem de captação, configurável por tenant (ARCHITECTURE.md §11).
model LeadOrigin {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]
  leads     Lead[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("lead_origins")
}

model Campaign {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  originId  String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  origin LeadOrigin? @relation(fields: [originId], references: [id])
  leads  Lead[]

  @@unique([tenantId, name])
  @@map("campaigns")
}

model Lead {
  id               String     @id @default(cuid())
  tenantId         String
  clientId         String
  assignedBrokerId String
  originId         String
  campaignId       String?
  status           LeadStatus @default(NEW)
  lostReason       String?    @db.VarChar(255)
  estimatedBudget  Decimal?   @db.Decimal(15, 2)
  lastContactAt    DateTime?
  nextContactAt    DateTime?
  notes            String?    @db.Text
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  client         Client              @relation(fields: [clientId], references: [id])
  assignedBroker User                @relation("LeadBroker", fields: [assignedBrokerId], references: [id])
  origin         LeadOrigin          @relation(fields: [originId], references: [id])
  campaign       Campaign?           @relation(fields: [campaignId], references: [id])
  statusHistory  LeadStatusHistory[]
  activities     Activity[]

  @@index([tenantId, status])
  @@index([tenantId, assignedBrokerId])
  @@index([tenantId, createdAt])
  @@map("leads")
}

model LeadStatusHistory {
  id              String      @id @default(cuid())
  tenantId        String
  leadId          String
  fromStatus      LeadStatus?
  toStatus        LeadStatus
  reason          String?     @db.VarChar(255)
  changedByUserId String?
  createdAt       DateTime    @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  lead      Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User?  @relation("LeadStatusAuthor", fields: [changedByUserId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_status_history")
}

/// Registro de contato/atividade ligado ao cliente e, quando houver, ao lead.
model Activity {
  id              String       @id @default(cuid())
  tenantId        String
  clientId        String?
  leadId          String?
  type            ActivityType
  description     String       @db.Text
  occurredAt      DateTime     @default(now())
  createdByUserId String?
  createdAt       DateTime     @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  client    Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ActivityAuthor", fields: [createdByUserId], references: [id])

  @@index([tenantId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([leadId, occurredAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Etapa 3 — imóveis, proprietários, mídia e interesse / matching
// ---------------------------------------------------------------------------

enum PropertyType {
  RESIDENTIAL_HOUSE
  APARTMENT
  PENTHOUSE
  TOWNHOUSE
  LOT
  FARM
  COMMERCIAL_OFFICE
  WAREHOUSE
  BUILDING
}

enum PropertyPurpose {
  SALE
  RENT
  BOTH
}

enum PropertyStatus {
  CAPTURING
  AVAILABLE
  RESERVED
  NEGOTIATION
  SOLD
  RENTED
  SUSPENDED
}

enum DocumentationStatus {
  FULLY_REGULARIZED
  IN_INVENTORY
  HABITE_PENDING
  FINANCEABLE
}

enum PropertyObjective {
  BUY
  RENT
}

enum PaymentMethod {
  CASH
  FINANCING
  BARTER
  DIRECT_INSTALLMENTS
  FGTS
}

enum AssetStorageProvider {
  LOCAL
  S3
}

enum PropertyMediaType {
  PHOTO
  VIDEO
  DOCUMENT
}

/// Imóvel: o coração do negócio. Pode ter múltiplos proprietários (PropertyOwner).
model Property {
  id                   String             @id @default(cuid())
  tenantId             String
  code                 String             // código único por tenant
  title                String
  type                 PropertyType
  purpose              PropertyPurpose
  captatorBrokerId     String?
  salePrice            Decimal?           @db.Decimal(15, 2)
  rentalPrice          Decimal?           @db.Decimal(15, 2)
  condoFee             Decimal?           @db.Decimal(15, 2)
  iptu                 Decimal?           @db.Decimal(15, 2)
  addressLine          String
  number               String?
  complement           String?            @db.VarChar(120)
  neighborhood         String
  city                 String
  state                String             @db.VarChar(2)
  zipCode              String?            @db.VarChar(10)
  latitude             Decimal?           @db.Decimal(10, 8)
  longitude            Decimal?           @db.Decimal(11, 8)
  totalArea            Decimal?           @db.Decimal(10, 2)
  privateArea          Decimal?           @db.Decimal(10, 2)
  bedrooms             Int?
  suites               Int?
  bathrooms           Int?
  parkingSpots        Int?
  documentationStatus  DocumentationStatus @default(FULLY_REGULARIZED)
  isExclusive         Boolean             @default(false)
  exclusivityEndsAt   DateTime?
  status              PropertyStatus      @default(AVAILABLE)
  description         String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  captatorBroker  User?             @relation("PropertyCaptator", fields: [captatorBrokerId], references: [id])
  owners          PropertyOwner[]
  media           PropertyMedia[]
  features        PropertyFeature[]
  interestMatches InterestProfile[] @relation("PropertyMatches")

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, captatorBrokerId])
  @@map("properties")
}

/// Vínculo entre Property e Client (um ou mais proprietários). isPrimary define responsável.
model PropertyOwner {
  id                  String  @id @default(cuid())
  tenantId            String
  propertyId          String
  clientId            String
  ownershipPercentage Int?    // 0-100
  isPrimary           Boolean @default(false)
  createdAt           DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id])

  @@unique([propertyId, clientId])
  @@index([tenantId])
  @@map("property_owners")
}

/// Característ icas do imóvel (piscina, churrasqueira, etc).
model PropertyFeature {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  name       String   @db.VarChar(120)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name])
  @@map("property_features")
}

/// Referência a ativo (foto, vídeo, documento). Binários não vão para MySQL.
model Asset {
  id               String                @id @default(cuid())
  tenantId         String
  kind             String                @db.VarChar(32) // 'photo', 'video', 'document'
  storageProvider  AssetStorageProvider
  path             String                @db.VarChar(512)
  mimeType         String                @db.VarChar(128)
  size             Int
  checksum         String                @db.VarChar(64)
  createdByUserId  String?
  createdAt        DateTime              @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  createdBy User?           @relation("AssetAuthor", fields: [createdByUserId], references: [id])
  inMedia   PropertyMedia[]

  @@index([tenantId, kind])
  @@map("assets")
}

/// Ligação entre Property e Asset com tipo de mídia e ordem.
model PropertyMedia {
  id         String            @id @default(cuid())
  propertyId String
  assetId    String
  type       PropertyMediaType
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id])

  @@unique([propertyId, assetId])
  @@index([propertyId, sortOrder])
  @@map("property_media")
}

/// Perfil de interesse: o que o cliente busca.
model InterestProfile {
  id                String         @id @default(cuid())
  tenantId          String
  clientId          String         @unique
  objective         PropertyObjective
  minPrice          Decimal?       @db.Decimal(15, 2)
  maxPrice          Decimal?       @db.Decimal(15, 2)
  minBedrooms       Int?
  minSuites         Int?
  minParkingSpots   Int?
  paymentMethod     Json @default("[]") // array de PaymentMethod
  needsFinancing    Boolean        @default(false)
  notes             String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  client            Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  preferredNeighborhoods String? @db.Text // CSV ou JSON
  matchedProperties Property[] @relation("PropertyMatches")

  @@index([tenantId, objective])
  @@map("interest_profiles")
}
