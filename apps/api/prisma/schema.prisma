// SENA CRM — schema.
// Etapa 0: fundação multi-tenant. Etapa 1: acesso, sessão, equipes e auditoria.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// A URL de conexão fica em prisma.config.ts (exigência do Prisma 7).
datasource db {
  provider = "mysql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  PLATFORM_ADMIN
  ADMIN
  MANAGER
  BROKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

/// Imobiliária. Todo dado operacional é vinculado a um Tenant.
model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  legalName String?
  document  String?      @unique // CNPJ
  timezone  String       @default("America/Sao_Paulo")
  locale    String       @default("pt-BR")
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  users          User[]
  teams          Team[]
  brokerProfiles BrokerProfile[]
  sessions       RefreshSession[]
  resetTokens    PasswordResetToken[]
  auditLogs      AuditLog[]

  clients         Client[]
  clientRoles     ClientRoleAssignment[]
  leadOrigins     LeadOrigin[]
  campaigns       Campaign[]
  leads           Lead[]
  leadStatusLogs  LeadStatusHistory[]
  activities      Activity[]


  properties         Property[]
  propertyOwners    PropertyOwner[]
  propertyFeatures  PropertyFeature[]
  assets            Asset[]
  interestProfiles  InterestProfile[]

  visits          Visit[]
  proposals       Proposal[]
  proposalHistory ProposalHistory[]
  sales           Sale[]
  saleSellers     SaleSeller[]
  commissions     Commission[]
  commissionSplits CommissionSplit[]

  leases              Lease[]
  leaseTenantsRel     LeaseTenant[]
  leaseOwnersRel      LeaseOwner[]
  rentCharges         RentCharge[]
  rentPayments        RentPayment[]
  ownerPayouts        OwnerPayout[]
  rentalExpenses      RentalExpense[]
  inspections         Inspection[]
  inspectionItems     InspectionItem[]
  inspectionMedia     InspectionMedia[]
  maintenanceRequests MaintenanceRequest[]
  serviceProviders    ServiceProvider[]
  maintenanceQuotes   MaintenanceQuote[]
  maintenanceEvents   MaintenanceEvent[]

  @@index([status])
  @@map("tenants")
}

/// Acesso ao sistema. Dados profissionais do corretor ficam em BrokerProfile.
model User {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  email        String
  passwordHash String     @db.VarChar(255)
  role         UserRole   @default(BROKER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  brokerProfile BrokerProfile?
  managedTeams  Team[]               @relation("TeamManager")
  ledProfiles   BrokerProfile[]      @relation("BrokerManager")
  sessions      RefreshSession[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]

  clientsResponsible Client[]            @relation("ClientResponsible")
  leadsAssigned      Lead[]              @relation("LeadBroker")
  leadStatusChanges  LeadStatusHistory[] @relation("LeadStatusAuthor")
  activitiesCreated  Activity[]          @relation("ActivityAuthor")


  propertiesCaptored Property[] @relation("PropertyCaptator")
  assetsCreated      Asset[]    @relation("AssetAuthor")

  visitsBroker         Visit[]
  proposalsBroker      Proposal[] @relation("ProposalBroker")
  proposalHistoryActor ProposalHistory[] @relation("ProposalHistoryActor")
  salesBroker          Sale[] @relation("SaleBroker")
  salesCaptator        Sale[] @relation("SaleCaptator")
  commissionSplits     CommissionSplit[]

  responsibleLeases   Lease[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

model Team {
  id            String     @id @default(cuid())
  tenantId      String
  name          String
  managerUserId String?
  status        TeamStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  manager User?           @relation("TeamManager", fields: [managerUserId], references: [id])
  brokers BrokerProfile[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("teams")
}

model BrokerProfile {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String   @unique
  creci         String?
  phone         String?
  whatsapp      String?
  teamId        String?
  managerUserId String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  user    User   @relation(fields: [userId], references: [id])
  team    Team?  @relation(fields: [teamId], references: [id])
  manager User?  @relation("BrokerManager", fields: [managerUserId], references: [id])

  @@index([tenantId])
  @@index([teamId])
  @@map("broker_profiles")
}

/// Sessão de refresh rotativa e revogável. Só o hash do token é persistido.
model RefreshSession {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?   @db.VarChar(512)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

/// Token de recuperação de senha: uso único, expira e é persistido apenas como hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, usedAt])
  @@map("password_reset_tokens")
}

/// Auditoria de ações críticas (ARCHITECTURE.md §20). Nunca guarda segredos.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String   @db.VarChar(64)
  entity    String?  @db.VarChar(64)
  entityId  String?
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Etapa 2 — cliente unificado, origens, campanhas, leads e atividades
// ---------------------------------------------------------------------------

enum ClientType {
  PERSON
  COMPANY
}

enum DocumentType {
  CPF
  CNPJ
}

enum ClientRole {
  BUYER
  OWNER
  LESSOR
  TENANT
  INVESTOR
}

enum LeadStatus {
  NEW
  CONTACT
  QUALIFIED
  PROPERTY_PRESENTED
  VISIT
  PROPOSAL
  NEGOTIATION
  CLOSED
  LOST
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  VISIT
  NOTE
}

/// Pessoa ou empresa. Um mesmo Client acumula papéis (ARCHITECTURE.md §10):
/// não existem cadastros separados de comprador, proprietário, locador ou locatário.
model Client {
  id                  String       @id @default(cuid())
  tenantId            String
  type                ClientType   @default(PERSON)
  name                String
  documentType        DocumentType?
  /// Documento normalizado sob AES-256-GCM; o valor em claro nunca é persistido.
  documentEncrypted   String?      @db.VarChar(512)
  /// HMAC determinístico: permite busca e checagem de duplicidade sem decifrar.
  documentHash        String?      @db.VarChar(64)
  documentLast4       String?      @db.VarChar(4)
  phone               String?      @db.VarChar(32)
  whatsapp            String?      @db.VarChar(32)
  email               String?      @db.VarChar(180)
  responsibleBrokerId String?
  lastContactAt       DateTime?
  nextContactAt       DateTime?
  notes               String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  responsibleBroker User?                 @relation("ClientResponsible", fields: [responsibleBrokerId], references: [id])
  roles             ClientRoleAssignment[]
  leads             Lead[]
  activities        Activity[]

  @@unique([tenantId, documentHash])
  @@index([tenantId, name])
  visits       Visit[]
  proposals    Proposal[]
  sales        Sale[] @relation("SaleBuyer")
  saleSellers  SaleSeller[]

  leaseTenantsRel  LeaseTenant[] @relation("LeaseTenant")
  leaseOwnersRel   LeaseOwner[] @relation("LeaseOwner")
  ownerPayouts     OwnerPayout[]

  propertyOwnerships PropertyOwner[]
  interestProfile    InterestProfile?
  @@index([tenantId, responsibleBrokerId])
  @@map("clients")
}

model ClientRoleAssignment {
  id        String     @id @default(cuid())
  tenantId  String
  clientId  String
  role      ClientRole
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, role])
  @@index([tenantId, role])
  @@map("client_role_assignments")
}

/// Origem de captação, configurável por tenant (ARCHITECTURE.md §11).
model LeadOrigin {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]
  leads     Lead[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("lead_origins")
}

model Campaign {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  originId  String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  origin LeadOrigin? @relation(fields: [originId], references: [id])
  leads  Lead[]

  @@unique([tenantId, name])
  @@map("campaigns")
}

model Lead {
  id               String     @id @default(cuid())
  tenantId         String
  clientId         String
  assignedBrokerId String
  originId         String
  campaignId       String?
  status           LeadStatus @default(NEW)
  lostReason       String?    @db.VarChar(255)
  estimatedBudget  Decimal?   @db.Decimal(15, 2)
  lastContactAt    DateTime?
  nextContactAt    DateTime?
  notes            String?    @db.Text
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  client         Client              @relation(fields: [clientId], references: [id])
  assignedBroker User                @relation("LeadBroker", fields: [assignedBrokerId], references: [id])
  origin         LeadOrigin          @relation(fields: [originId], references: [id])
  campaign       Campaign?           @relation(fields: [campaignId], references: [id])
  statusHistory  LeadStatusHistory[]
  activities     Activity[]

  @@index([tenantId, status])
  @@index([tenantId, assignedBrokerId])
  @@index([tenantId, createdAt])
  @@map("leads")
}

model LeadStatusHistory {
  id              String      @id @default(cuid())
  tenantId        String
  leadId          String
  fromStatus      LeadStatus?
  toStatus        LeadStatus
  reason          String?     @db.VarChar(255)
  changedByUserId String?
  createdAt       DateTime    @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  lead      Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User?  @relation("LeadStatusAuthor", fields: [changedByUserId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_status_history")
}

/// Registro de contato/atividade ligado ao cliente e, quando houver, ao lead.
model Activity {
  id              String       @id @default(cuid())
  tenantId        String
  clientId        String?
  leadId          String?
  type            ActivityType
  description     String       @db.Text
  occurredAt      DateTime     @default(now())
  createdByUserId String?
  createdAt       DateTime     @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  client    Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ActivityAuthor", fields: [createdByUserId], references: [id])

  @@index([tenantId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([leadId, occurredAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Etapa 3 — imóveis, proprietários, mídia e interesse / matching
// ---------------------------------------------------------------------------

enum PropertyType {
  RESIDENTIAL_HOUSE
  APARTMENT
  PENTHOUSE
  TOWNHOUSE
  LOT
  FARM
  COMMERCIAL_OFFICE
  WAREHOUSE
  BUILDING
}

enum PropertyPurpose {
  SALE
  RENT
  BOTH
}

enum PropertyStatus {
  CAPTURING
  AVAILABLE
  RESERVED
  NEGOTIATION
  SOLD
  RENTED
  SUSPENDED
}

enum DocumentationStatus {
  FULLY_REGULARIZED
  IN_INVENTORY
  HABITE_PENDING
  FINANCEABLE
}

enum PropertyObjective {
  BUY
  RENT
}

enum PaymentMethod {
  CASH
  FINANCING
  BARTER
  DIRECT_INSTALLMENTS
  FGTS
}

enum AssetStorageProvider {
  LOCAL
  S3
}

enum PropertyMediaType {
  PHOTO
  VIDEO
  DOCUMENT
}

/// Imóvel: o coração do negócio. Pode ter múltiplos proprietários (PropertyOwner).
model Property {
  id                   String             @id @default(cuid())
  tenantId             String
  code                 String             // código único por tenant
  title                String
  type                 PropertyType
  purpose              PropertyPurpose
  captatorBrokerId     String?
  salePrice            Decimal?           @db.Decimal(15, 2)
  rentalPrice          Decimal?           @db.Decimal(15, 2)
  condoFee             Decimal?           @db.Decimal(15, 2)
  iptu                 Decimal?           @db.Decimal(15, 2)
  addressLine          String
  number               String?
  complement           String?            @db.VarChar(120)
  neighborhood         String
  city                 String
  state                String             @db.VarChar(2)
  zipCode              String?            @db.VarChar(10)
  latitude             Decimal?           @db.Decimal(10, 8)
  longitude            Decimal?           @db.Decimal(11, 8)
  totalArea            Decimal?           @db.Decimal(10, 2)
  privateArea          Decimal?           @db.Decimal(10, 2)
  bedrooms             Int?
  suites               Int?
  bathrooms           Int?
  parkingSpots        Int?
  documentationStatus  DocumentationStatus @default(FULLY_REGULARIZED)
  isExclusive         Boolean             @default(false)
  exclusivityEndsAt   DateTime?
  status              PropertyStatus      @default(AVAILABLE)
  description         String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  captatorBroker  User?             @relation("PropertyCaptator", fields: [captatorBrokerId], references: [id])
  owners          PropertyOwner[]
  media           PropertyMedia[]
  features        PropertyFeature[]
  interestMatches InterestProfile[] @relation("PropertyMatches")

  @@unique([tenantId, code])
  @@index([tenantId, status])
  visits       Visit[]
  proposals    Proposal[]
  sales        Sale[]
  leases       Lease[]

  @@index([tenantId, captatorBrokerId])
  @@map("properties")
}

/// Vínculo entre Property e Client (um ou mais proprietários). isPrimary define responsável.
model PropertyOwner {
  id                  String  @id @default(cuid())
  tenantId            String
  propertyId          String
  clientId            String
  ownershipPercentage Int?    // 0-100
  isPrimary           Boolean @default(false)
  createdAt           DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id])

  @@unique([propertyId, clientId])
  @@index([tenantId])
  @@map("property_owners")
}

/// Característ icas do imóvel (piscina, churrasqueira, etc).
model PropertyFeature {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  name       String   @db.VarChar(120)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name])
  @@map("property_features")
}

/// Referência a ativo (foto, vídeo, documento). Binários não vão para MySQL.
model Asset {
  id               String                @id @default(cuid())
  tenantId         String
  kind             String                @db.VarChar(32) // 'photo', 'video', 'document'
  storageProvider  AssetStorageProvider
  path             String                @db.VarChar(512)
  mimeType         String                @db.VarChar(128)
  size             Int
  checksum         String                @db.VarChar(64)
  createdByUserId  String?
  createdAt        DateTime              @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  createdBy User?           @relation("AssetAuthor", fields: [createdByUserId], references: [id])
  inMedia   PropertyMedia[]

  @@index([tenantId, kind])
  @@map("assets")
}

/// Ligação entre Property e Asset com tipo de mídia e ordem.
model PropertyMedia {
  id         String            @id @default(cuid())
  propertyId String
  assetId    String
  type       PropertyMediaType
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id])

  @@unique([propertyId, assetId])
  @@index([propertyId, sortOrder])
  @@map("property_media")
}

/// Perfil de interesse: o que o cliente busca.
model InterestProfile {
  id                String         @id @default(cuid())
  tenantId          String
  clientId          String         @unique
  objective         PropertyObjective
  minPrice          Decimal?       @db.Decimal(15, 2)
  maxPrice          Decimal?       @db.Decimal(15, 2)
  minBedrooms       Int?
  minSuites         Int?
  minParkingSpots   Int?
  paymentMethod     Json @default("[]") // array de PaymentMethod
  needsFinancing    Boolean        @default(false)
  notes             String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  client            Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  preferredNeighborhoods String? @db.Text // CSV ou JSON
  matchedProperties Property[] @relation("PropertyMatches")

  @@index([tenantId, objective])
  @@map("interest_profiles")
}

// ---------------------------------------------------------------------------
// Etapa 4 — visitas, propostas, vendas e comissões (transação atômica)
// ---------------------------------------------------------------------------

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  COUNTER_PROPOSED
  APPROVED
  REJECTED
  EXPIRED
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}


enum CommissionStatus {
  PENDING
  EXPECTED
  RECEIVED
  SETTLED
  CANCELLED
}

enum CommissionRole {
  AGENCY
  MANAGER
  CAPTATOR
  ATTENDANT_BROKER
  NEGOTIATOR
  PARTNER
}

/// Visita agendada a imóvel.
model Visit {
  id              String      @id @default(cuid())
  tenantId        String
  clientId        String
  propertyId      String
  brokerId        String
  scheduledAt     DateTime
  durationMinutes Int?
  status          VisitStatus @default(SCHEDULED)
  feedback        String?     @db.Text
  impression      String?     @db.VarChar(255)
  createdAt       DateTime    @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  broker   User     @relation(fields: [brokerId], references: [id])

  @@index([tenantId, scheduledAt])
  @@index([propertyId, status])
  @@map("visits")
}

/// Proposta de compra/aluguel.
model Proposal {
  id                   String          @id @default(cuid())
  tenantId             String
  code                 String
  clientId             String
  propertyId           String
  brokerId             String
  advertisedPrice      Decimal         @db.Decimal(15, 2)
  proposedPrice        Decimal         @db.Decimal(15, 2)
  downPayment          Decimal?        @db.Decimal(15, 2)
  installmentsCount    Int?
  installmentsValue    Decimal?        @db.Decimal(15, 2)
  paymentMethod        String          @db.VarChar(64)
  paymentDescription   String?         @db.Text
  counterProposalPrice Decimal?        @db.Decimal(15, 2)
  counterProposalNotes String?         @db.Text
  status               ProposalStatus  @default(DRAFT)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  client   Client          @relation(fields: [clientId], references: [id])
  property Property        @relation(fields: [propertyId], references: [id])
  broker   User            @relation("ProposalBroker", fields: [brokerId], references: [id])
  history  ProposalHistory[]
  sale     Sale?

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("proposals")
}

/// Histórico de mudanças em proposta.
model ProposalHistory {
  id         String  @id @default(cuid())
  tenantId   String
  proposalId String
  actorId    String?
  fromStatus ProposalStatus?
  toStatus   ProposalStatus?
  action     String  @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  actor    User?    @relation("ProposalHistoryActor", fields: [actorId], references: [id])

  @@index([proposalId, createdAt])
  @@map("proposal_history")
}

/// Venda fechada (após proposta aprovada).
model Sale {
  id                   String               @id @default(cuid())
  tenantId             String
  code                 String
  proposalId           String?              @unique
  propertyId           String
  buyerClientId        String
  brokerId             String
  captatorBrokerId     String?
  finalSalePrice       Decimal              @db.Decimal(15, 2)
  saleDate             DateTime
  paymentType          String               @db.VarChar(64)
  contractNumber       String?              @db.VarChar(64)
  documentationStatus  DocumentationStatus
  status               SaleStatus           @default(PENDING)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  proposal         Proposal?        @relation(fields: [proposalId], references: [id])
  property         Property         @relation(fields: [propertyId], references: [id])
  buyer            Client           @relation("SaleBuyer", fields: [buyerClientId], references: [id])
  broker           User             @relation("SaleBroker", fields: [brokerId], references: [id])
  captator         User?            @relation("SaleCaptator", fields: [captatorBrokerId], references: [id])
  sellers          SaleSeller[]
  commission       Commission?

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([propertyId])
  @@map("sales")
}

/// Múltiplos vendedores por venda.
model SaleSeller {
  id         String   @id @default(cuid())
  tenantId   String
  saleId     String
  clientId   String
  percentage Decimal? @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id])

  @@unique([saleId, clientId])
  @@map("sale_sellers")
}

/// Comissão de uma venda (não armazenar dezenas de colunas fixas).
model Commission {
  id              String            @id @default(cuid())
  tenantId        String
  saleId          String?           @unique
  baseValue       Decimal           @db.Decimal(15, 2)
  totalPercentage Decimal           @db.Decimal(6, 2)
  totalValue      Decimal           @db.Decimal(15, 2)
  status          CommissionStatus  @default(PENDING)
  expectedAt      DateTime?
  receivedAt      DateTime?
  settledAt       DateTime?
  createdAt       DateTime          @default(now())

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  sale   Sale?               @relation(fields: [saleId], references: [id])
  splits CommissionSplit[]

  @@index([tenantId, status])
  @@map("commissions")
}

/// Split de comissão (múltiplos receptores, regra: soma <= total).
model CommissionSplit {
  id              String           @id @default(cuid())
  tenantId        String
  commissionId    String
  recipientType   CommissionRole
  recipientId     String?
  recipientName   String?          @db.VarChar(180)
  percentage      Decimal          @db.Decimal(6, 2)
  amount          Decimal          @db.Decimal(15, 2)
  status          CommissionStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime         @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  commission  Commission  @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  recipient   User?       @relation(fields: [recipientId], references: [id])

  @@index([commissionId])
  @@index([tenantId, status])
  @@map("commission_splits")
}

// ---------------------------------------------------------------------------
// Etapa 5 — locações, cobranças, repasses, vistorias e manutenção
// ---------------------------------------------------------------------------

enum LeaseStatus {
  ACTIVE
  PAUSED
  COMPLETED
  TERMINATED
}

enum InspectionType {
  ENTRY
  PERIODIC
  EXIT
}

enum RentChargeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum MaintenanceStatus {
  REQUESTED
  QUOTED
  APPROVED
  COMPLETED
  CANCELLED
}

/// Contrato de locação.
model Lease {
  id                     String      @id @default(cuid())
  tenantId               String
  contractNumber         String      @db.VarChar(64)
  propertyId             String
  responsibleBrokerId    String?
  monthlyRent            Decimal     @db.Decimal(15, 2)
  condoFee               Decimal?    @db.Decimal(15, 2)
  iptuFee                Decimal?    @db.Decimal(15, 2)
  startDate              DateTime
  endDate                DateTime
  dueDay                 Int         @db.TinyInt
  guaranteeType          String      @db.VarChar(64)
  adminFeePercentage     Decimal     @db.Decimal(6, 2)
  adjustmentIndex        String?     @db.VarChar(64)
  nextAdjustmentDate     DateTime?
  status                 LeaseStatus @default(ACTIVE)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  property            Property       @relation(fields: [propertyId], references: [id])
  responsibleBroker   User?          @relation(fields: [responsibleBrokerId], references: [id])
  tenants             LeaseTenant[]
  owners              LeaseOwner[]
  charges             RentCharge[]
  payouts             OwnerPayout[]
  expenses            RentalExpense[]
  inspections         Inspection[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([tenantId, contractNumber])
  @@index([propertyId, status])
  @@index([tenantId, status])
  @@map("leases")
}

/// Locatário de uma locação.
model LeaseTenant {
  id         String   @id @default(cuid())
  tenantId   String
  leaseId    String
  clientId   String
  percentage Decimal? @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  lease  Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  client Client @relation("LeaseTenant", fields: [clientId], references: [id])

  @@unique([leaseId, clientId])
  @@index([leaseId])
  @@map("lease_tenants")
}

/// Proprietário/beneficiário de uma locação (snapshot + relation).
model LeaseOwner {
  id         String   @id @default(cuid())
  tenantId   String
  leaseId    String
  clientId   String
  percentage Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  lease  Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  client Client @relation("LeaseOwner", fields: [clientId], references: [id])

  @@unique([leaseId, clientId])
  @@index([leaseId])
  @@map("lease_owners")
}

/// Cobrança de aluguel (uma por competência/mês).
model RentCharge {
  id               String           @id @default(cuid())
  tenantId         String
  leaseId          String
  competence       DateTime         @db.Date
  dueDate          DateTime
  rentAmount       Decimal          @db.Decimal(15, 2)
  condoAmount      Decimal          @db.Decimal(15, 2)
  iptuAmount       Decimal          @db.Decimal(15, 2)
  otherAmount      Decimal          @db.Decimal(15, 2)
  discountAmount   Decimal          @db.Decimal(15, 2)
  fineAmount       Decimal          @db.Decimal(15, 2)
  interestAmount   Decimal          @db.Decimal(15, 2)
  totalAmount      Decimal          @db.Decimal(15, 2)
  status           RentChargeStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  lease    Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments RentPayment[]

  @@unique([leaseId, competence])
  @@index([leaseId, status])
  @@index([tenantId, status])
  @@map("rent_charges")
}

/// Recebimento de aluguel (pode ser parcial).
model RentPayment {
  id           String   @id @default(cuid())
  tenantId     String
  chargeId     String
  amount       Decimal  @db.Decimal(15, 2)
  paymentDate  DateTime
  receiptUrl   String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  charge RentCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([chargeId])
  @@index([tenantId, paymentDate])
  @@map("rent_payments")
}

/// Repasse ao proprietário (cálculo de aluguel menos taxas e despesas).
model OwnerPayout {
  id                  String   @id @default(cuid())
  tenantId            String
  leaseId             String
  competence          DateTime @db.Date
  ownerClientId       String
  rentAmount          Decimal  @db.Decimal(15, 2)
  adminFeeAmount      Decimal  @db.Decimal(15, 2)
  expensesAmount      Decimal  @db.Decimal(15, 2)
  netAmount           Decimal  @db.Decimal(15, 2)
  payoutDate          DateTime?
  payoutReceiptUrl    String?
  notes               String?  @db.Text
  createdAt           DateTime @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  lease       Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  ownerClient Client @relation(fields: [ownerClientId], references: [id])

  @@unique([leaseId, competence, ownerClientId])
  @@index([leaseId])
  @@index([tenantId])
  @@map("owner_payouts")
}

/// Despesas autorizadas/passáveis (água, luz, etc).
model RentalExpense {
  id            String   @id @default(cuid())
  tenantId      String
  leaseId       String
  competence    DateTime @db.Date
  description   String   @db.VarChar(255)
  amount        Decimal  @db.Decimal(15, 2)
  isAuthorized  Boolean  @default(false)
  createdAt     DateTime @default(now())
  authorizedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  lease  Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId, competence])
  @@index([tenantId])
  @@map("rental_expenses")
}

/// Vistoria/inspeção de imóvel.
model Inspection {
  id            String          @id @default(cuid())
  tenantId      String
  leaseId       String
  inspectionType InspectionType
  inspectorName String?         @db.VarChar(180)
  notes         String?         @db.Text
  inspectedAt   DateTime
  createdAt     DateTime        @default(now())

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  lease  Lease                @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  items  InspectionItem[]
  media  InspectionMedia[]

  @@index([leaseId, inspectionType])
  @@index([tenantId])
  @@map("inspections")
}

/// Item de checklist em vistoria.
model InspectionItem {
  id             String   @id @default(cuid())
  tenantId       String
  inspectionId   String
  description    String   @db.VarChar(255)
  status         String   @db.VarChar(64)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  inspection  Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_items")
}

/// Mídia/fotos da vistoria.
model InspectionMedia {
  id            String   @id @default(cuid())
  tenantId      String
  inspectionId  String
  url           String
  mimeType      String   @db.VarChar(64)
  uploadedAt    DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  inspection  Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_media")
}

/// Solicitação de manutenção.
model MaintenanceRequest {
  id              String             @id @default(cuid())
  tenantId        String
  leaseId         String
  description     String             @db.Text
  status          MaintenanceStatus  @default(REQUESTED)
  requestedAt     DateTime           @default(now())
  completedAt     DateTime?
  createdAt       DateTime           @default(now())

  tenant  Tenant                 @relation(fields: [tenantId], references: [id])
  lease   Lease                  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  quotes  MaintenanceQuote[]
  events  MaintenanceEvent[]

  @@index([leaseId, status])
  @@index([tenantId])
  @@map("maintenance_requests")
}

/// Prestador de serviço.
model ServiceProvider {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   @db.VarChar(180)
  phone       String?  @db.VarChar(32)
  email       String?  @db.VarChar(180)
  category    String?  @db.VarChar(64)
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  quotes  MaintenanceQuote[]
  events  MaintenanceEvent[]

  @@index([tenantId, isActive])
  @@map("service_providers")
}

/// Orçamento de manutenção.
model MaintenanceQuote {
  id              String   @id @default(cuid())
  tenantId        String
  requestId       String
  providerId      String
  description     String   @db.Text
  amount          Decimal  @db.Decimal(15, 2)
  dueDate         DateTime?
  isApproved      Boolean  @default(false)
  createdAt       DateTime @default(now())
  approvedAt      DateTime?

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  request   MaintenanceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider  ServiceProvider     @relation(fields: [providerId], references: [id])

  @@index([requestId])
  @@index([providerId])
  @@map("maintenance_quotes")
}

/// Evento/conclusão de manutenção.
model MaintenanceEvent {
  id              String   @id @default(cuid())
  tenantId        String
  requestId       String
  providerId      String
  description     String   @db.Text
  amount          Decimal  @db.Decimal(15, 2)
  completedAt     DateTime @default(now())
  invoiceUrl      String?
  createdAt       DateTime @default(now())

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  request   MaintenanceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider  ServiceProvider     @relation(fields: [providerId], references: [id])

  @@index([requestId])
  @@index([providerId])
  @@map("maintenance_events")
}

